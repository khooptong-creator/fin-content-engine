# Fin-Content Engine — worker environment.
# Copy to `.env` and fill in. Two-tier config (Part II §2.5):
#   - Secrets + structural config → here (FCE_ prefix).
#   - Tuning values (thresholds, cadences, caps) → the `config` table in Postgres.

# --- Supabase (worker uses service-role key, bypasses RLS) ---
FCE_SUPABASE_URL=https://YOURPROJECT.supabase.co
FCE_SUPABASE_SERVICE_KEY=replace-with-service-role-key

# --- Postgres direct connection (used by worker for pgvector queries) ---
# The Supabase pooler is fine for dev; the direct connection is needed for some pgvector ops.
FCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fce

# --- SEC EDGAR (mandatory UA per their fair-access policy; carries your email) ---
FCE_EDGAR_USER_AGENT=Fin-Content Engine fin-content@yourdomain.example (Your Name)

# --- Embedding edge function ---
FCE_EMBEDDING_EDGE_FUNCTION_URL=https://YOURPROJECT.functions.supabase.co/embed
FCE_EMBEDDING_TIMEOUT_SECONDS=5

# --- Worker runtime ---
FCE_SCHEDULER_MAX_WORKERS=4
FCE_LOG_LEVEL=INFO

# --- Test-only (read by conftest.py / docker-compose) ---
# When true, ingest uses a deterministic mock embedder instead of the edge function.
FCE_EMBED_MOCK=true
