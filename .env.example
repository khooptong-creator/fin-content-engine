# Fin-Content Engine — worker environment.
# Copy to `.env` and fill in. Two-tier config (Part II §2.5):
#   - Secrets + structural config → here (FCE_ prefix).
#   - Tuning values (thresholds, cadences, caps) → the `config` table in Postgres.

# --- Postgres (self-hosted on the VPS, Option C from the deploy design) ---
FCE_DATABASE_URL=postgresql://fce:<DB_PASSWORD>@127.0.0.1:5432/fce

# --- SEC EDGAR (mandatory UA per their fair-access policy; carries your email) ---
FCE_EDGAR_USER_AGENT=Fin-Content Engine fin-content@lamkalabs.com (Your Name)

# --- Embeddings (local fce-embedder service, Option C) ---
# The worker calls the local embedder rather than a cloud edge function. The
# embedder is a ~40-line FastAPI app wrapping sentence-transformers/gte-small,
# running on 127.0.0.1:8001 as its own systemd service (fce-embedder.service).
FCE_EMBEDDING_EDGE_FUNCTION_URL=http://127.0.0.1:8001/embed
FCE_EMBEDDING_TIMEOUT_SECONDS=5

# --- Worker runtime ---
FCE_SCHEDULER_MAX_WORKERS=4
FCE_LOG_LEVEL=INFO

# --- Supabase (OPTIONAL in P1) ---
# P1 doesn't use Supabase at all (embeddings are local, DB is local Postgres).
# These settings exist for P3, when the GUI uses Supabase Auth (magic-link).
# Leave them as defaults for now; fill in P3.
FCE_SUPABASE_URL=http://localhost:54321
FCE_SUPABASE_SERVICE_KEY=dev-only

# --- Test-only (read by conftest.py / docker-compose) ---
# When true, ingest uses a deterministic mock embedder instead of the real one.
FCE_EMBED_MOCK=true
