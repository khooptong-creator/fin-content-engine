[Unit]
Description=Fin-Content Engine embedder (local gte-small embeddings)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fce
Group=fce
# WorkingDirectory MUST point at the embedder dir so uvicorn finds app.py
# (uvicorn imports "app:app" relative to CWD).
WorkingDirectory=/opt/fce/current/embedder
# HF_HOME tells sentence-transformers / huggingface_hub where the model cache
# lives, so model load doesn't depend on CWD. The fce user's home is /opt/fce,
# so the default cache path is /opt/fce/.cache/huggingface — pin it explicitly
# to be safe (and resilient to HOME being unset under systemd).
Environment=HF_HOME=/opt/fce/.cache/huggingface
Environment=FCE_EMBED_MODEL=thenlper/gte-small
ExecStart=/opt/fce/embedder/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=10

# Slightly longer restart interval than the worker (10s vs 5s) because model
# load takes ~3-5s on cold start — we don't want a tight restart loop hammering
# the box if something is wrong with the model file.

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
